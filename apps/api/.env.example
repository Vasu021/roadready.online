# PostgreSQL connection string.
DATABASE_URL=postgresql://roadready_user:roadready_pass@localhost:5432/roadready

# Secret used to sign session JWTs. Must be at least 24 characters.
# In production a missing or short value is a startup error, not a warning.
# Generate one with: openssl rand -base64 48
JWT_SECRET=change_me_to_a_long_random_value

PORT=3001

# Comma-separated list of browser origins allowed to call this API.
# Defaults to http://localhost:5173 when unset.
CORS_ORIGIN=http://localhost:5173

# Set to "true" when running behind a reverse proxy so client IPs — and with
# them the rate limiter — are read from X-Forwarded-For.
TRUST_PROXY=false
