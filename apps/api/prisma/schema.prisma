generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ScenarioType {
  PRACTICE
  TEST
}

enum AttemptMode {
  PRACTICE
  TEST
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  /// Preferred content language, one of the 13 the official exam supports.
  locale    String   @default("en")
  /// Preferred visual theme (study, wood, greenboard, blackboard, daylight, contrast).
  theme     String   @default("study")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  attempts         ScenarioAttempt[]
  moduleProgress   UserModuleProgress[]
  progress         UserProgress[]
  countryAccess    UserCountryAccess[]
  scenarioProgress UserScenarioProgress[]
  testSessions     TestSession[]

  @@map("users")
}

model Country {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  flagEmoji String   @map("flag_emoji")
  isActive  Boolean  @default(false) @map("is_active")
  facts     String?
  createdAt DateTime @default(now()) @map("created_at")

  categories   ScenarioCategory[]
  scenarios    Scenario[]
  userAccess   UserCountryAccess[]
  testSessions TestSession[]

  @@map("countries")
}

model ScenarioCategory {
  id        String @id @default(cuid())
  countryId String @map("country_id")
  name      String
  order     Int

  country   Country    @relation(fields: [countryId], references: [id], onDelete: Cascade)
  scenarios Scenario[]

  @@map("scenario_categories")
}

// ── Reference library ────────────────────────────────────────────────────────
// Traffic signs are rendered from code (apps/web/src/components/signs), so this
// table is metadata-only: it exists so server-side features (search, sign-based
// question generation, admin tooling) have something to join against. It is not
// seeded by default.
model Sign {
  id          String   @id @default(cuid())
  countryCode String   @map("country_code")
  signKey     String   @unique @map("sign_key")
  nameDE      String   @map("name_de")
  nameEN      String   @map("name_en")
  category    String
  description String
  explanation String
  legalBasis  String?  @map("legal_basis")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("signs")
}

// ── Topic-wise practice tests ────────────────────────────────────────────────
model TopicTest {
  id          String   @id @default(cuid())
  countryCode String   @map("country_code")
  slug        String   @unique
  name        String
  nameEN      String   @map("name_en")
  description String
  order       Int
  isActive    Boolean  @default(true) @map("is_active")
  /// Sign-recognition topics feed the sign block of the final theory test.
  isSignTopic Boolean  @default(false) @map("is_sign_topic")
  createdAt   DateTime @default(now()) @map("created_at")

  questions Question[]
  attempts  ScenarioAttempt[]

  @@map("topic_tests")
}

// A Scenario is now a single driving-situation question (image + MCQ), not a
// 3D simulation. `type` still distinguishes PRACTICE scenarios from the TEST row.
model Scenario {
  id          String       @id @default(cuid())
  countryId   String       @map("country_id")
  categoryId  String?      @map("category_id")
  slug        String       @unique
  name        String
  description String
  order       Int
  isActive    Boolean      @default(false) @map("is_active")
  isPremium   Boolean      @default(false) @map("is_premium")
  type        ScenarioType
  videoUrl    String?      @map("video_url")
  imagePrompt String?      @map("image_prompt")
  imageUrl    String?      @map("image_url")
  /// Composable scene description rendered to SVG by the client.
  sceneJson   Json?        @map("scene_json")
  createdAt   DateTime     @default(now()) @map("created_at")

  country          Country                @relation(fields: [countryId], references: [id], onDelete: Cascade)
  category         ScenarioCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  questions        Question[]
  scenarioAttempts ScenarioAttempt[]
  userProgress     UserScenarioProgress[]

  @@map("scenarios")
}

// A Question belongs to EITHER a TopicTest (topic-wise practice) or a Scenario
// (driving-situation practice). Exactly one of the two FKs is set.
model Question {
  id           String   @id @default(cuid())
  scenarioId   String?  @map("scenario_id")
  topicTestId  String?  @map("topic_test_id")
  moduleId     String?  @map("module_id")
  questionText String   @map("question_text")
  order        Int
  explanation  String
  /// Official weighting: a question is worth 2 to 5 error points when wrong.
  errorPoints  Int      @default(3) @map("error_points")
  createdAt    DateTime @default(now()) @map("created_at")

  scenario           Scenario?           @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  topicTest          TopicTest?          @relation(fields: [topicTestId], references: [id], onDelete: Cascade)
  module             Module?             @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  options            Option[]
  testSessionAnswers TestSessionAnswer[]

  @@index([scenarioId])
  @@index([topicTestId])
  @@index([moduleId])
  @@map("questions")
}

model Option {
  id         String  @id @default(cuid())
  questionId String  @map("question_id")
  optionText String  @map("option_text")
  isCorrect  Boolean @map("is_correct")
  order      Int

  question           Question            @relation(fields: [questionId], references: [id], onDelete: Cascade)
  testSessionAnswers TestSessionAnswer[]

  @@map("options")
}

model UserCountryAccess {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  countryId  String   @map("country_id")
  unlockedAt DateTime @default(now()) @map("unlocked_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@unique([userId, countryId])
  @@map("user_country_access")
}

model UserScenarioProgress {
  id            String         @id @default(cuid())
  userId        String         @map("user_id")
  scenarioId    String         @map("scenario_id")
  status        ProgressStatus @default(NOT_STARTED)
  lastAttemptAt DateTime?      @map("last_attempt_at")
  bestScore     Int            @default(0) @map("best_score")
  attemptCount  Int            @default(0) @map("attempt_count")
  passCount     Int            @default(0) @map("pass_count")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenario Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@unique([userId, scenarioId])
  @@map("user_scenario_progress")
}

// Legacy progress model — kept for backwards compat with existing API routes.
// New code should use UserScenarioProgress / ScenarioAttempt.
model UserProgress {
  id              String    @id @default(cuid())
  userId          String    @map("user_id")
  scenarioId      String    @map("scenario_id")
  bestScore       Int       @default(0) @map("best_score")
  bestTimeSeconds Int?      @map("best_time_seconds")
  attemptCount    Int       @default(0) @map("attempt_count")
  passCount       Int       @default(0) @map("pass_count")
  lastAttemptAt   DateTime? @map("last_attempt_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scenarioId])
  @@map("user_progress")
}

// One finished practice run — of a TopicTest (topicTestId set) or of a single
// Scenario question (scenarioId set).
model ScenarioAttempt {
  id             String      @id @default(cuid())
  userId         String      @map("user_id")
  scenarioId     String?     @map("scenario_id")
  topicTestId    String?     @map("topic_test_id")
  mode           AttemptMode @default(PRACTICE)
  passed         Boolean
  score          Int         @default(0)
  totalQuestions Int?        @map("total_questions")
  timeSeconds    Int         @map("time_seconds")
  completedAt    DateTime    @default(now()) @map("completed_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenario  Scenario?  @relation(fields: [scenarioId], references: [id], onDelete: SetNull)
  topicTest TopicTest? @relation(fields: [topicTestId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("scenario_attempts")
}

model TestSession {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  countryId   String    @map("country_id")
  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")
  totalScore  Int       @default(0) @map("total_score")
  maxScore    Int       @map("max_score")
  /// Error points accumulated; the official rule allows at most 10.
  errorPoints Int       @default(0) @map("error_points")
  /// True when two 5-point questions were wrong, which fails regardless of total.
  failedByFivePointRule Boolean @default(false) @map("failed_by_five_point_rule")
  passed      Boolean?
  grade       String?

  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  country Country             @relation(fields: [countryId], references: [id], onDelete: Cascade)
  answers TestSessionAnswer[]

  @@map("test_sessions")
}

model TestSessionAnswer {
  id               String   @id @default(cuid())
  testSessionId    String   @map("test_session_id")
  questionId       String   @map("question_id")
  selectedOptionId String   @map("selected_option_id")
  isCorrect        Boolean  @map("is_correct")
  answeredAt       DateTime @default(now()) @map("answered_at")

  testSession    TestSession @relation(fields: [testSessionId], references: [id], onDelete: Cascade)
  question       Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption Option      @relation(fields: [selectedOptionId], references: [id], onDelete: Cascade)

  @@unique([testSessionId, questionId])
  @@map("test_session_answers")
}


// ── Learning modules ─────────────────────────────────────────────────────────
// One module per lesson of the legally mandated curriculum (FahrschAusbO,
// Anlage 1 for the Grundstoff and Anlage 2.2 for the class-B Zusatzstoff).
model Module {
  id               String   @id @default(cuid())
  countryCode      String   @map("country_code")
  slug             String   @unique
  order            Int
  /// The official German lesson title from the FahrschAusbO.
  officialTitle    String   @map("official_title")
  /// Our display title in the base locale (English).
  title            String
  summary          String
  /// Why this module matters, shown above the lesson list.
  intro            String
  estimatedMinutes Int      @default(20) @map("estimated_minutes")
  /// Lessons 13 and 14 are the class-B Zusatzstoff rather than Grundstoff.
  isZusatzstoff    Boolean  @default(false) @map("is_zusatzstoff")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")

  lessons   Lesson[]
  questions Question[]
  progress  UserModuleProgress[]

  @@index([countryCode])
  @@map("modules")
}

model Lesson {
  id        String   @id @default(cuid())
  moduleId  String   @map("module_id")
  slug      String   @unique
  order     Int
  title     String
  /// Lesson body in a restricted markdown subset.
  body      String
  /// JSON array of short "remember this" lines.
  keyPoints Json     @map("key_points")
  /// Optional scene rendered beside the text.
  sceneJson Json?    @map("scene_json")
  /// JSON array of sign ids rendered as a strip under the body.
  signIds   Json?    @map("sign_ids")
  createdAt DateTime @default(now()) @map("created_at")

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId])
  @@map("lessons")
}

model UserModuleProgress {
  id                 String    @id @default(cuid())
  userId             String    @map("user_id")
  moduleId           String    @map("module_id")
  /// JSON array of lesson ids the user has marked read.
  completedLessonIds Json      @map("completed_lesson_ids")
  lastLessonId       String?   @map("last_lesson_id")
  completedAt        DateTime? @map("completed_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
  @@map("user_module_progress")
}

// ── Translations ─────────────────────────────────────────────────────────────
// One generic table for every translatable database field. Adding a language
// is inserting rows; no schema change and no per-entity translation table.
// Interface strings and sign text live in the frontend locale files instead.
model Translation {
  id         String   @id @default(cuid())
  /// "module" | "lesson" | "question" | "option" | "scenario" | "topicTest" | "country"
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  /// The field on that entity, e.g. "title", "body", "questionText".
  field      String
  locale     String
  value      String
  /// Machine-translated rows are served but flagged until a human confirms them.
  isMachine  Boolean  @default(true) @map("is_machine")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([entityType, entityId, field, locale])
  @@index([entityType, locale])
  @@map("translations")
}
