// RoadReady — scenario-based driving theory MCQs
// See REWRITE_PLAN.md for the reasoning behind this model.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum QuizMode {
  PRACTICE
  EXAM
}

enum QuizSource {
  TOPIC
  EXAM
  MISTAKES
  BOOKMARKS
}

enum QuizStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

// ── Content layer ───────────────────────────────────────────────────────────

model Country {
  id        String  @id @default(cuid())
  code      String  @unique
  name      String
  flagEmoji String  @map("flag_emoji")
  isActive  Boolean @default(false) @map("is_active")
  order     Int     @default(0)
  facts     String?

  // Mock-exam configuration, per country so rules can differ.
  examQuestionCount Int @default(20) @map("exam_question_count")
  examPassPercent   Int @default(75) @map("exam_pass_percent")

  createdAt DateTime @default(now()) @map("created_at")

  categories Category[]
  topics     Topic[]
  quizzes    Quiz[]
  users      User[]

  @@map("countries")
}

model Category {
  id          String  @id @default(cuid())
  countryId   String  @map("country_id")
  slug        String
  name        String
  description String?
  order       Int     @default(0)

  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)
  topics  Topic[]

  @@unique([countryId, slug])
  @@map("categories")
}

/// A themed group of scenario questions — "Roundabouts", "Priority Signs".
model Topic {
  id          String  @id @default(cuid())
  countryId   String  @map("country_id")
  categoryId  String? @map("category_id")
  slug        String  @unique
  name        String
  description String
  iconEmoji   String  @default("🚦") @map("icon_emoji")
  order       Int     @default(0)
  isActive    Boolean @default(true) @map("is_active")
  isPremium   Boolean @default(false) @map("is_premium")

  createdAt DateTime @default(now()) @map("created_at")

  country   Country         @relation(fields: [countryId], references: [id], onDelete: Cascade)
  category  Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  questions Question[]
  progress  TopicProgress[]
  quizzes   Quiz[]

  @@index([countryId, order])
  @@map("topics")
}

/// One scenario-based multiple choice question: an image, a prompt, four options.
model Question {
  id          String     @id @default(cuid())
  topicId     String     @map("topic_id")
  order       Int        @default(0)
  prompt      String
  /// Relative path under apps/web/public (e.g. "/images/scenarios/x.svg") or an absolute URL.
  imageUrl    String?    @map("image_url")
  imageAlt    String?    @map("image_alt")
  explanation String
  difficulty  Difficulty @default(MEDIUM)
  isActive    Boolean    @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  topic     Topic          @relation(fields: [topicId], references: [id], onDelete: Cascade)
  options   Option[]
  quizItems QuizItem[]
  stats     QuestionStat[]

  @@index([topicId, order])
  @@map("questions")
}

model Option {
  id         String  @id @default(cuid())
  questionId String  @map("question_id")
  /// Stable display label — "A", "B", "C", "D".
  label      String
  text       String
  isCorrect  Boolean @default(false) @map("is_correct")
  order      Int     @default(0)

  question       Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedInQuiz QuizItem[]

  @@index([questionId, order])
  @@map("options")
}

// ── User layer ──────────────────────────────────────────────────────────────

model User {
  id                String  @id @default(cuid())
  email             String  @unique
  password          String
  name              String?
  role              Role    @default(USER)
  isPremium         Boolean @default(false) @map("is_premium")
  selectedCountryId String? @map("selected_country_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  selectedCountry Country?        @relation(fields: [selectedCountryId], references: [id], onDelete: SetNull)
  quizzes         Quiz[]
  topicProgress   TopicProgress[]
  questionStats   QuestionStat[]

  @@map("users")
}

/// One run through a set of questions. The question set is frozen at creation
/// time as QuizItem rows so scoring and resuming stay deterministic.
model Quiz {
  id        String     @id @default(cuid())
  userId    String     @map("user_id")
  countryId String     @map("country_id")
  topicId   String?    @map("topic_id")
  mode      QuizMode   @default(PRACTICE)
  source    QuizSource @default(TOPIC)
  status    QuizStatus @default(IN_PROGRESS)

  totalQuestions Int      @map("total_questions")
  correctCount   Int      @default(0) @map("correct_count")
  scorePercent   Int      @default(0) @map("score_percent")
  passed         Boolean?
  grade          String?

  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  country Country    @relation(fields: [countryId], references: [id], onDelete: Cascade)
  topic   Topic?     @relation(fields: [topicId], references: [id], onDelete: SetNull)
  items   QuizItem[]

  @@index([userId, startedAt])
  @@map("quizzes")
}

model QuizItem {
  id               String    @id @default(cuid())
  quizId           String    @map("quiz_id")
  questionId       String    @map("question_id")
  order            Int
  selectedOptionId String?   @map("selected_option_id")
  isCorrect        Boolean?  @map("is_correct")
  answeredAt       DateTime? @map("answered_at")

  quiz           Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption Option?  @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  @@unique([quizId, questionId])
  @@index([quizId, order])
  @@map("quiz_items")
}

model TopicProgress {
  id      String         @id @default(cuid())
  userId  String         @map("user_id")
  topicId String         @map("topic_id")
  status  ProgressStatus @default(NOT_STARTED)

  bestScorePercent Int       @default(0) @map("best_score_percent")
  attemptCount     Int       @default(0) @map("attempt_count")
  passCount        Int       @default(0) @map("pass_count")
  lastAttemptAt    DateTime? @map("last_attempt_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@map("topic_progress")
}

/// Per-user, per-question history. Powers "review my mistakes", bookmarks, and
/// (later) spaced repetition scheduling.
model QuestionStat {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  questionId   String   @map("question_id")
  timesSeen    Int      @default(0) @map("times_seen")
  timesCorrect Int      @default(0) @map("times_correct")
  timesWrong   Int      @default(0) @map("times_wrong")
  isBookmarked Boolean  @default(false) @map("is_bookmarked")
  lastSeenAt   DateTime @default(now()) @map("last_seen_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId, isBookmarked])
  @@map("question_stats")
}
